# VEYRA Local API configuration. Copy to .env and adjust as needed.
# See services/local-api/app/core/config.py and
# docs/security/01-SECURITY-ARCHITECTURE.md.

VEYRA_APP_NAME="VEYRA Local API"
VEYRA_ENVIRONMENT=development

# Never change these to a non-loopback address without first addressing
# docs/security/03-THREAT-MODEL.md §5 (no auth token yet).
VEYRA_HOST=127.0.0.1
VEYRA_PORT=8756

VEYRA_DATABASE_URL=sqlite+aiosqlite:///./veyra.db

# Dev-only fallback secret — see docs/security/05-DATA-PROTECTION.md §1.
# Production Windows builds use DPAPI instead. Never commit a real value.
VEYRA_SECRET_KEY=change-me-in-a-real-deployment

VEYRA_LOG_LEVEL=INFO

# --- Subsystem activation: AI/Voice/Vision provider configuration ---
# See services/local-api/app/services/subsystem_health.py and
# docs/subsystem-activation/. Leave blank to keep a subsystem
# NOT CONFIGURED (the safe, honest default). Never commit a real value.
#
# AI: an OpenAI-compatible chat-completions endpoint (OpenAI itself, most
# OpenAI-compatible cloud providers, or a local Ollama/LM Studio server).
# All four must be set together, or AI stays NOT CONFIGURED.
VEYRA_AI_PROVIDER=
VEYRA_AI_MODEL=
VEYRA_AI_API_KEY=
VEYRA_AI_BASE_URL=

# Voice: real, local, offline providers exist for all three — see
# docs/voice-hardware/SETUP.md for exactly what to install/download and
# where. All three (provider + its model/path) must be set for the
# always-on wake-word hardware pipeline to actually start; a partial
# setup is reported honestly via GET /system's voice.details reason.
VEYRA_STT_PROVIDER=
VEYRA_TTS_PROVIDER=
VEYRA_WAKE_WORD_PROVIDER=

# openWakeWord: a bundled pretrained phrase name (hey_jarvis/alexa/
# hey_mycroft/hey_rhasspy) or a path to a custom-trained .onnx model.
VEYRA_WAKE_WORD_MODEL=hey_jarvis
VEYRA_WAKE_WORD_THRESHOLD=0.5

# pywhispercpp: a known whisper.cpp shorthand (auto-downloaded on first
# use) or a direct path to an existing ggml model file.
VEYRA_WHISPER_MODEL=base.en
VEYRA_WHISPER_MODELS_DIR=

# Piper: a real voice .onnx file path you download once — see
# docs/voice-hardware/SETUP.md. Blank keeps TTS on the honest
# NotConfiguredTTS fallback regardless of VEYRA_TTS_PROVIDER.
VEYRA_PIPER_VOICE_MODEL_PATH=

# Optional device selection for the real sounddevice-backed audio I/O —
# blank uses the OS default microphone/speaker.
VEYRA_AUDIO_INPUT_DEVICE=
VEYRA_AUDIO_OUTPUT_DEVICE=

# Vision: declares intent only — no real vision-*model* (AI scene
# understanding) implementation ships in this build yet; OCR/screen-
# capture are real and independent of this setting (see
# subsystem_health.py's own docstring).
VEYRA_VISION_PROVIDER=
