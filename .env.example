# VEYRA Local API configuration. Copy to .env and adjust as needed.
# See services/local-api/app/core/config.py and
# docs/security/01-SECURITY-ARCHITECTURE.md.

VEYRA_APP_NAME="VEYRA Local API"
VEYRA_ENVIRONMENT=development

# Never change these to a non-loopback address without first addressing
# docs/security/03-THREAT-MODEL.md §5 (no auth token yet).
VEYRA_HOST=127.0.0.1
VEYRA_PORT=8756

VEYRA_DATABASE_URL=sqlite+aiosqlite:///./veyra.db

# Dev-only fallback secret — see docs/security/05-DATA-PROTECTION.md §1.
# Production Windows builds use DPAPI instead. Never commit a real value.
VEYRA_SECRET_KEY=change-me-in-a-real-deployment

VEYRA_LOG_LEVEL=INFO

# --- Subsystem activation: AI/Voice/Vision provider configuration ---
# See services/local-api/app/services/subsystem_health.py and
# docs/subsystem-activation/. Leave blank to keep a subsystem
# NOT CONFIGURED (the safe, honest default). Never commit a real value.
#
# AI: an OpenAI-compatible chat-completions endpoint (OpenAI itself, most
# OpenAI-compatible cloud providers, or a local Ollama/LM Studio server).
# All four must be set together, or AI stays NOT CONFIGURED.
VEYRA_AI_PROVIDER=
VEYRA_AI_MODEL=
VEYRA_AI_API_KEY=
VEYRA_AI_BASE_URL=

# Voice/vision: declares intent only — no real STT/TTS/wake-word/vision-
# model implementation ships in this build yet (see subsystem_health.py's
# own docstring), so voice/vision remain NOT CONFIGURED regardless. Left
# here so the health check can report an accurate reason once a real
# provider adapter exists in a future phase.
VEYRA_STT_PROVIDER=
VEYRA_TTS_PROVIDER=
VEYRA_WAKE_WORD_PROVIDER=
VEYRA_VISION_PROVIDER=
